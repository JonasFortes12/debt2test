# LLM Provider selection: openai, anthropic, or custom
DEBT_TESTER_PROVIDER=openai

# Your API Key for the selected provider
DEBT_TESTER_API_KEY=your_api_key_here

# Model name override (defaults to gpt-4o for OpenAI, claude-3-5-sonnet for Anthropic)
DEBT_TESTER_MODEL=gpt-4o

# Optional custom API endpoint URL
DEBT_TESTER_ENDPOINT=