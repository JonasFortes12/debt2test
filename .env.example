DEBT_TESTER_PROVIDER=gemini
DEBT_TESTER_API_KEY=
DEBT_TESTER_MODEL=gemini-3.5-flash-lite

# Jira context for the CLI (the REST API takes these per request instead).
# Leave the base URL empty to skip context. Base URL alone = public Jira (anonymous);
# a private Jira also needs EMAIL and API_TOKEN, which must be set together.
DEBT_CONTEXT_JIRA_BASE_URL=
DEBT_CONTEXT_JIRA_EMAIL=
DEBT_CONTEXT_JIRA_API_TOKEN=

# Database persistence (CLI: off unless DEBT_PERSISTENCE_ENABLED=true; debt-api always uses it)
DEBT_PERSISTENCE_ENABLED=true
DEBT_DB_PORT=5434
DEBT_DB_URL=jdbc:postgresql://localhost:5434/debt2test
DEBT_DB_USERNAME=debt2test
DEBT_DB_PASSWORD=
DEBT_DB_POOL_SIZE=5

# debt-api (optional; only used when running the REST module)
DEBT_API_PORT=8182
DEBT_API_ALLOWED_ORIGIN=http://localhost:5173

# Access codes for debt-api (optional; defaults shown)
DEBT_ACCESS_RUN_QUOTA=3
DEBT_ACCESS_CODE_TTL=72h
DEBT_ACCESS_RESULTS_TTL=30d
DEBT_ACCESS_REQUEST_COOLDOWN=5m
# Code requests accepted per client IP per hour
DEBT_ACCESS_IP_LIMIT=10
# Must match debt-api/src/main/resources/terms/terms-<version>.md
DEBT_ACCESS_TERMS_VERSION=v1
# If set, emails include <url>/?code=<code>
DEBT_ACCESS_FRONTEND_URL=

# Email delivery for access codes. Leave DEBT_MAIL_HOST empty to print codes to the API log (dev only).
DEBT_MAIL_HOST=
DEBT_MAIL_PORT=587
DEBT_MAIL_USERNAME=
DEBT_MAIL_PASSWORD=
DEBT_MAIL_FROM=
